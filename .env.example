# -- EXTRACTORS CREDENTIALS --
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# -- DATABASE --
# Host process (uv / just): use localhost (ports published by data compose).
# Inside pipeline/app containers on network `skillpolaris`: use hostnames db / qdrant / ollama.
DB_PATH=
DB_HOST=localhost
DB_PORT=5432

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# -- SCRIPT --
MAX_TOTAL_DETAILS=
MAX_DEPTH=
EXTRACT_KEYWORD_LIMIT=50
EXTRACT_KEYWORD_COOLDOWN_HOURS=24
TRANSFORM_BATCH_SIZE=25
FILTER_BATCH_SIZE=50

# -- LLM MODEL --
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# -- QDRANT --
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=job_offers
QDRANT_VECTOR_SIZE=768

# -- APP (compose.app) --
NEXT_PUBLIC_API_URL=http://localhost:8000
