# SkillPolaris — Docker / prod-like. Copy to `.env` and fill every value.
# Empty required vars will fail at startup (no silent defaults in Settings).

# -- EXTRACTORS CREDENTIALS --
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# -- DATABASE --
DB_PATH=./postgres_data
DB_HOST=db
DB_PORT=5432

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgweb UI (data compose): http://127.0.0.1:8081
PGWEB_PORT=8081

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# -- PIPELINE LIMITS --
MAX_TOTAL_DETAILS=50
MAX_DEPTH=3
EXTRACT_KEYWORD_LIMIT=50
EXTRACT_KEYWORD_COOLDOWN_HOURS=24
TRANSFORM_BATCH_SIZE=25
FILTER_BATCH_SIZE=50

# -- LLM / OLLAMA --
LLM_MODEL=
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# -- QDRANT --
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=job_offers
QDRANT_VECTOR_SIZE=768

# -- PREFECT --
# Containers / workers (Docker DNS)
PREFECT_API_URL=http://prefect-server:4200/api
# Browser on the host (published port). UI: http://127.0.0.1:4200
PREFECT_UI_API_URL=http://127.0.0.1:4200/api
PREFECT_PORT=4200
PREFECT_WORK_POOL=skillpolaris
INGEST_CRON=0 */6 * * *
SYNC_KEYWORDS_CRON=0 3 * * 0

# -- APP --
# Browser on the host talks to published ports.
NEXT_PUBLIC_API_URL=http://localhost:8000
