# SkillPolaris — Docker / prod-like. Copy to `.env` and fill every value.
# Empty required vars will fail at startup (no silent defaults in Settings).

# -- EXTRACTORS CREDENTIALS --
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Search page size for /offres/search (API max 150).
FRANCE_TRAVAIL_PAGE_SIZE=150
# Bundesagentur: only scope search to jobs published within N days (API max 100).
BUNDESAGENTUR_LOOKBACK_DAYS=30
# Comma-separated Greenhouse board tokens (HITL).
GREENHOUSE_BOARD_TOKENS=stripe,datadog,cloudflare,airbnb,figma
# Comma-separated Lever board tokens (HITL).
LEVER_BOARD_TOKENS=palantir
# Comma-separated Ashby job board names (HITL).
ASHBY_BOARD_TOKENS=notion,linear
# Comma-separated Recruitee company subdomains.
RECRUITEE_BOARD_TOKENS=sirclecollection
# Comma-separated Workable account subdomains.
WORKABLE_BOARD_TOKENS=huggingface
# Comma-separated SmartRecruiters company identifiers.
SMARTRECRUITERS_BOARD_TOKENS=SmartRecruiters
# Free self-serve key at https://developer.adzuna.com/ — empty until registered.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=gb,de,fr

# -- DATABASE --
DB_PATH=./postgres_data
DB_HOST=db
DB_PORT=5432

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Override these when running more than one worktree's stack at once — every
# container name, the Compose project name, and the network are otherwise
# identical across worktrees (docker-compose.data.yml / .pipeline.yml), so
# whichever worktree runs `up` last silently takes over/rewires the others'
# containers instead of erroring. Defaults below match the previous behavior.
COMPOSE_PROJECT_NAME=skillpolaris
COMPOSE_NETWORK_NAME=skillpolaris
DB_CONTAINER_NAME=postgres_db
PGWEB_CONTAINER_NAME=pgweb
PREFECT_CONTAINER_NAME=prefect
PIPELINE_WORKER_CONTAINER_NAME=pipeline_worker
LANGFUSE_WEB_CONTAINER_NAME=langfuse_web
LANGFUSE_WORKER_CONTAINER_NAME=langfuse_worker
LANGFUSE_POSTGRES_CONTAINER_NAME=langfuse_postgres
LANGFUSE_CLICKHOUSE_CONTAINER_NAME=langfuse_clickhouse
LANGFUSE_REDIS_CONTAINER_NAME=langfuse_redis
LANGFUSE_MINIO_CONTAINER_NAME=langfuse_minio

# pgweb UI
PGWEB_PORT=8081

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# -- PIPELINE LIMITS --
MAX_TOTAL_DETAILS=50
MAX_DEPTH=3
EXTRACT_KEYWORD_LIMIT=50
EXTRACT_KEYWORD_COOLDOWN_HOURS=24
ENRICH_BATCH_SIZE=25
FILTER_BATCH_SIZE=50
FILTER_MIN_DESCRIPTION_CHARS=80
FILTER_LLM_EXCERPT_CHARS=1500
FILTER_LLM_CONFIDENCE=0.7

# -- LLM CHAT (filter + enrich metadata; OpenAI-compatible) --
# DeepSeek example: https://api.deepseek.com/v1 + your API key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Small/cheap chat model for the filter gate (can differ from LLM_MODEL).
FILTER_LLM_MODEL=

# -- PREFECT --
# Containers / workers (Docker DNS)
PREFECT_API_URL=http://prefect-server:4200/api
# Relative path so the browser calls the same host it used to load the UI
# (works for 127.0.0.1, Tailscale IP/hostname, or a reverse proxy domain).
PREFECT_UI_API_URL=/api
PREFECT_PORT=4200
PREFECT_WORK_POOL=skillpolaris
# Stage schedules (staggered so filter/enrich drain Postgres between extracts)
EXTRACT_CRON=0 */6 * * *
FILTER_CRON=15 */2 * * *
ENRICH_CRON=45 */1 * * *
SYNC_KEYWORDS_CRON=0 3 * * 0

# -- LANGFUSE (docker-compose.langfuse.yml) --
# Self-hosted LLM observability for filter/enrich. Org/project/user/API keys
# below are auto-provisioned on first boot — no manual UI setup needed.
# UI: http://127.0.0.1:3001 (kept off 3000 — that's WEB_PORT below).
LANGFUSE_PORT=3001
# CHANGEME: generate with `openssl rand -hex 16` (or any random string).
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_PASSWORD=
# CHANGEME: generate with `openssl rand -hex 32` — must be exactly 64 hex chars.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# CHANGEME: any unique strings work; pk-lf-/sk-lf- just mirrors Langfuse's own format.
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# Read by the pipeline itself (pipeline/observability.py) — internal Docker
# network address, reachable once docker-compose.langfuse.yml is up.
LANGFUSE_OTEL_ENDPOINT=http://langfuse-web:3000/api/public/otel

# -- APP (docker-compose.app.yml) --
# Host ports published for api/web.
API_PORT=8000
WEB_PORT=3000

# Browser on the host talks to published ports.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (Next.js SSR) talks to the api container over the Docker network.
API_INTERNAL_URL=http://api:8000
